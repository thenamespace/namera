{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": [".env", ".env.*", "tsconfig.json"],
  "tasks": {
    "build": {
      "dependsOn": ["^build", "typecheck"],
      "env": [
        "CI",
        "NITRO_PRESET",
        "VERCEL",
        "POSTHOG_API_HOST",
        "POSTHOG_API_KEY",
        "POSTHOG_PROJECT_ID",
        "VITE_API_URL",
        "VITE_SITE_URL",
        "VITE_TELEMETRY_SERVICE_VERSION",
        "VERCEL_ENV",
        "VERCEL_GIT_COMMIT_SHA"
      ],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**", ".output/**", ".vercel/output/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "typecheck:test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test:watch": {
      "cache": false,
      "persistent": true
    },
    "clean": {
      "cache": false
    }
  }
}
