node_modules/
.pnpm-store/
.pnp.*
.yarn/*
!.yarn/patches/
!.yarn/plugins/
!.yarn/releases/
bower_components/
jspm_packages/
web_modules/

# ── JavaScript and TypeScript builds ──────────────────────────────────────────
dist/
build/
out/
lib-cov/
*.tsbuildinfo
*.tgz
next-env.d.ts

