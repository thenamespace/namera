{
  "$schema": "../../../../../node_modules/oxlint/configuration_schema.json",
  "jsPlugins": ["@effect-kit/oxc/oxlint", "../../../../oxlint/namera.ts"],
  "rules": {
    "effect/no-import-from-barrel-package": ["error", { "checkPatterns": ["^effect$"] }],
    "namera/no-effect-run": "error",
    "namera/no-foreign-internal": "error"
  },
  "overrides": [
    { "files": ["src/internal/promise.ts"], "rules": { "namera/no-effect-run": "off" } },
    {
      "files": ["src/internal/core/**"],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          { "patterns": [{ "group": ["viem", "viem/*"], "message": "viem-free" }] }
        ]
      }
    }
  ]
}
