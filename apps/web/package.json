{
  "name": "@namera-ai/web",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite dev --port 4000",
    "format": "oxfmt . --write --no-error-on-unmatched-pattern",
    "format:check": "oxfmt . --check --no-error-on-unmatched-pattern",
    "generate-routes": "tsr generate",
    "lint": "oxlint . --no-error-on-unmatched-pattern",
    "preview": "vite preview --port 4000",
    "test": "NODE_OPTIONS=--conditions=namera-source vitest run",
    "typecheck": "pnpm generate-routes && tsc -p tsconfig.json --pretty false"
  },
  "dependencies": {
    "@fontsource-variable/inter": "catalog:",
    "@hookform/resolvers": "catalog:",
    "@namera-ai/protocol": "workspace:*",
    "@namera-ai/ui": "workspace:*",
    "@number-flow/react": "^0.6.2",
    "@paper-design/shaders-react": "^0.0.80",
    "@tanstack/react-router": "catalog:web",
    "@tanstack/react-start": "catalog:",
    "@xyflow/react": "^12.11.6",
    "effect": "catalog:",
    "motion": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-hook-form": "catalog:"
  },
  "devDependencies": {
    "@tailwindcss/vite": "catalog:",
    "@tanstack/router-cli": "catalog:web",
    "@types/mdx": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:web",
    "klarity": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:web",
    "vitest": "catalog:"
  }
}
