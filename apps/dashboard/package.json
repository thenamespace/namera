{
  "name": "@namera-ai/dashboard",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite dev --port 3000",
    "format": "oxfmt . --write --no-error-on-unmatched-pattern",
    "format:check": "oxfmt . --check --no-error-on-unmatched-pattern",
    "generate-routes": "tsr generate",
    "lint": "oxlint . --no-error-on-unmatched-pattern",
    "lint:fix": "oxlint . --fix --no-error-on-unmatched-pattern",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --pretty false"
  },
  "dependencies": {
    "@effect/atom-react": "catalog:",
    "@fontsource-variable/inter": "catalog:",
    "@namera-ai/api": "workspace:*",
    "@namera-ai/protocol": "workspace:*",
    "@namera-ai/ui": "workspace:*",
    "@tailwindcss/vite": "catalog:",
    "@tanstack/react-devtools": "catalog:",
    "@tanstack/react-router": "catalog:",
    "@tanstack/react-router-devtools": "catalog:",
    "effect": "catalog:",
    "motion": "^13.0.0",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwindcss": "catalog:",
    "usehooks-ts": "^3.1.1"
  },
  "devDependencies": {
    "@tanstack/devtools-vite": "catalog:",
    "@tanstack/router-cli": "catalog:",
    "@tanstack/router-plugin": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "klarity": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:"
  }
}
