AUTH_DASHBOARD_PUBLIC_ORIGIN=https://app.example.com # Dashboard URL

# Google Login Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Database Configuration
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DATABASE=namera
POSTGRES_USERNAME=
POSTGRES_PASSWORD=

# Encryption Keys
CRYPTO_HMAC_KEY=
CRYPTO_ENCRYPTION_KEY=

# Invite code Configuration
AUTH_INVITE_REQUIRED=true

ADMIN_BOOTSTRAP_OWNER_EMAIL=vedant@namespace.ninja # Admin Portal Owner Email

# Alchemy Configuration
EVM_ALCHEMY_API_KEY=
EVM_ALCHEMY_BSO_POLICY_ID=
