# Copy to a private env file outside source control and replace example values.
# Docker: docker run --env-file /path/to/server.env -p 8080:8080 namera-server
# Supply secrets through your deployment secret manager. Do not bake them into the image.
NODE_ENV=production

SERVER_HOST=0.0.0.0
SERVER_PORT=8080
# Required behind ingress for per-client IP limits: use confirmed proxy IPs/CIDRs only.
# Blank ignores forwarded headers. Restrict origin access to the trusted ingress.
SERVER_TRUSTED_PROXY_CIDRS=
# Use your exact HTTPS dashboard origin (no path or trailing slash).
SERVER_CORS_ORIGIN=https://app.example.com
# Landing-page origin; does not gain access to credentialed dashboard routes.
WAITLIST_CORS_ORIGIN=https://www.example.com
# Operator-portal origin; the only origin allowed to send a bearer token to
# /internal. Restrict /internal at the ingress as well.
ADMIN_CORS_ORIGIN=https://admin.example.com
AUTH_API_PUBLIC_ORIGIN=https://api.example.com
AUTH_DASHBOARD_PUBLIC_ORIGIN=https://app.example.com

# Reachable from the server container; localhost would refer to the container itself.
# Startup applies migrations, so this database user needs migration privileges.
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DATABASE=namera
POSTGRES_USERNAME=
POSTGRES_PASSWORD=

# Generate two independent 32-byte base64url secrets; keep stable across deployments.
# Run twice: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# Replacing these keys can invalidate credentials or make encrypted data unreadable.
CRYPTO_HMAC_KEY=
CRYPTO_ENCRYPTION_KEY=

# Private-beta admission and platform-admin access.
AUTH_INVITE_REQUIRED=true
# Generate separately: openssl rand -hex 32
# Missing/short values disable admin routes. Never expose this token to clients.
ADMIN_TOKEN=

# Alchemy RPC + sponsored operations, Blockscout, and Namespace ENS credentials.
EVM_ALCHEMY_API_KEY=
EVM_ALCHEMY_BSO_POLICY_ID=
BLOCKSCOUT_API_KEY=
NAMERA_ENS_API_KEY=

# Resend: use a verified sending domain. Reply-to is optional.
RESEND_API_KEY=
EMAIL_FROM=Namera <hello@example.com>
# EMAIL_REPLY_TO=support@example.com

# Axiom: create these datasets and provide a token permitted to ingest into them.
# Deployed release tag or Git SHA, attached to logs, traces, and metrics.
TELEMETRY_SERVICE_VERSION=replace-with-release-version
AXIOM_API_TOKEN=
AXIOM_OTLP_BASE_URL=https://api.axiom.co
AXIOM_TRACES_DATASET=namera-traces
AXIOM_LOGS_DATASET=namera-logs
AXIOM_METRICS_DATASET=namera-metrics
