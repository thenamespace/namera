NODE_ENV=development

SERVER_HOST=0.0.0.0
SERVER_PORT=8080
SERVER_CORS_ORIGIN=http://localhost:3000
# Optional landing-page origin; allowed only on public waitlist submissions.
# WAITLIST_CORS_ORIGIN=http://localhost:3002
# Optional operator-portal origin; the only origin allowed to send a bearer
# token to /internal. Leave blank to keep /internal on the dashboard policy.
# ADMIN_CORS_ORIGIN=http://localhost:3003

AUTH_API_PUBLIC_ORIGIN=http://localhost:8080
AUTH_DASHBOARD_PUBLIC_ORIGIN=http://localhost:3000
# Optional Google sign-in; configure both or leave both empty.
# Register ${AUTH_API_PUBLIC_ORIGIN}/auth/google/callback as an exact redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DATABASE=namera
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=postgres

CRYPTO_HMAC_KEY=generate_a_secure_secret_base64_url_encoded
CRYPTO_ENCRYPTION_KEY=generate_a_secure_secret_base64_url_encoded_1

EVM_ALCHEMY_API_KEY=
EVM_ALCHEMY_BSO_POLICY_ID=
# Server-only management token for confirmed sponsored-gas billing (not the RPC key).
ALCHEMY_ACCESS_TOKEN=

TELEMETRY_SERVICE_VERSION=development
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Required when NODE_ENV is not development.
# RESEND_API_KEY=
# EMAIL_FROM=Namera <hey@namera.ai>
# EMAIL_REPLY_TO=hey@namera.ai
# AXIOM_API_TOKEN=
# AXIOM_OTLP_BASE_URL=https://api.axiom.co
# AXIOM_TRACES_DATASET=namera-traces
# AXIOM_LOGS_DATASET=namera-logs
# AXIOM_METRICS_DATASET=namera-metrics
# Private beta: new users require a single-use invite. Existing users can log in.
AUTH_INVITE_REQUIRED=true
# Admin access uses normal user sessions and platform memberships, not a shared token.
# Optional: grant the first owner to an existing verified user after startup migrations.
# Blank disables bootstrap; an existing owner is never replaced. Remove after success.
ADMIN_BOOTSTRAP_OWNER_EMAIL=

# 1Claw is enabled. Configure the Platform app, OIDC trust and controlled org email domain.
ONECLAW_ORG_EMAIL_DOMAIN=
# Create the Platform app and an active template with spec={} in the 1Claw dashboard.
# Pin the template version; do not edit this template after deployment.
ONECLAW_PLATFORM_APP_ID=
ONECLAW_PLATFORM_API_KEY=
ONECLAW_EMPTY_TEMPLATE_ID=
ONECLAW_EMPTY_TEMPLATE_VERSION=1
# Configure the app's OIDC trust with this issuer/audience and public JWKS.
# Issuer must be AUTH_API_PUBLIC_ORIGIN/providers/1claw (no trailing slash).
# Discovery and jwks.json are served beneath that issuer. No public token issuance.
ONECLAW_OIDC_ISSUER=
ONECLAW_OIDC_AUDIENCE=
ONECLAW_OIDC_KEY_ID=
# RSA PKCS#8 PEM; quoted literal \n escapes are accepted. Never use a 1Claw human key.
ONECLAW_OIDC_PRIVATE_KEY=
