NODE_ENV=development

SERVER_HOST=0.0.0.0
SERVER_PORT=8080
# Optional comma-separated trusted reverse-proxy IPs/CIDRs. Blank ignores forwarded headers.
SERVER_TRUSTED_PROXY_CIDRS=
SERVER_CORS_ORIGIN=http://localhost:3000
# Optional landing-page origin; allowed only on public waitlist submissions.
# WAITLIST_CORS_ORIGIN=http://localhost:3002
# Optional operator-portal origin; the only origin allowed to send a bearer
# token to /internal. Leave blank to keep /internal on the dashboard policy.
# ADMIN_CORS_ORIGIN=http://localhost:3003

AUTH_API_PUBLIC_ORIGIN=http://localhost:8080
AUTH_DASHBOARD_PUBLIC_ORIGIN=http://localhost:3000
# Optional Google sign-in; configure both or leave both empty.
# Register ${AUTH_API_PUBLIC_ORIGIN}/auth/google/callback as an exact redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DATABASE=namera
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=postgres

CRYPTO_HMAC_KEY=generate_a_secure_secret_base64_url_encoded
CRYPTO_ENCRYPTION_KEY=generate_a_secure_secret_base64_url_encoded_1

EVM_ALCHEMY_API_KEY=
EVM_ALCHEMY_BSO_POLICY_ID=
# Server-only management token for confirmed sponsored-gas billing (not the RPC key).
ALCHEMY_ACCESS_TOKEN=
BLOCKSCOUT_API_KEY=

TELEMETRY_SERVICE_VERSION=development
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Required when NODE_ENV is not development.
# RESEND_API_KEY=
# EMAIL_FROM=Namera <hey@namera.ai>
# EMAIL_REPLY_TO=hey@namera.ai
# AXIOM_API_TOKEN=
# AXIOM_OTLP_BASE_URL=https://api.axiom.co
# AXIOM_TRACES_DATASET=namera-traces
# AXIOM_LOGS_DATASET=namera-logs
# AXIOM_METRICS_DATASET=namera-metrics
# Private beta: new users require a single-use invite. Existing users can log in.
AUTH_INVITE_REQUIRED=true
# Set a random secret of at least 32 characters in your secret manager.
# Missing/short values disable all platform-admin API routes.
ADMIN_TOKEN=
