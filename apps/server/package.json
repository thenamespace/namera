{
  "name": "@namera-ai/server",
  "version": "0.1.0",
  "private": "true",
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "build": "tsdown",
    "dev": "pnpm migrate && pnpm tsx src/index.ts --watch",
    "migrate": "pnpm tsx ./scripts/migrate.ts",
    "start": "node dist/migrate.mjs && node dist/index.mjs"
  },
  "dependencies": {
    "@effect/platform-node": "catalog:",
    "@namera-ai/api": "workspace:*",
    "@namera-ai/auth": "workspace:*",
    "@namera-ai/database": "workspace:*",
    "@namera-ai/domain": "workspace:*",
    "@namera-ai/schema": "workspace:*",
    "@namera-ai/telemetry": "workspace:*",
    "@namera-ai/utils": "workspace:*",
    "dotenv": "17.4.2",
    "drizzle-orm": "catalog:",
    "effect": "catalog:",
    "pg": "catalog:"
  },
  "devDependencies": {
    "@namera-ai/config": "workspace:*",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "tsdown": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  }
}
