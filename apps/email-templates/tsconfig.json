{
  "extends": "klarity/tsconfig/app",
  "compilerOptions": {
    "customConditions": ["namera-source"],
    "rootDir": "src",
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "target": "ES2022",
    "paths": {
      "@namera-ai/emails": ["../../packages/emails"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"]
}
