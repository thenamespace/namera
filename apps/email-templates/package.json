{
  "name": "@namera-ai/email-templates",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "files": [
    "dist"
  ],
  "type": "module",
  "imports": {
    "#/*": "./src/*.ts"
  },
  "exports": {
    ".": {
      "namera-source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "imports": {
      "#/*": "./dist/*.js"
    },
    "exports": {
      ".": "./dist/index.js",
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "tsdown --config tsdown.config.ts",
    "email:assets": "tsx --tsconfig ../../packages/ui/tsconfig.json script/generate-assets.tsx",
    "format": "oxfmt . --write --no-error-on-unmatched-pattern",
    "format:check": "oxfmt . --check --no-error-on-unmatched-pattern",
    "lint": "oxlint . --no-error-on-unmatched-pattern",
    "lint:fix": "oxlint . --fix --no-error-on-unmatched-pattern",
    "prepack": "pnpm run build",
    "typecheck": "tsc -p tsconfig.json --pretty false",
    "test": "pnpm --filter @namera-ai/emails build && tsx --tsconfig tsconfig.json --test tests/unit/*.test.tsx",
    "dev": "email dev -d ./src/emails -p 4000"
  },
  "dependencies": {
    "@namera-ai/emails": "workspace:*",
    "@namera-ai/protocol": "workspace:*",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-email": "catalog:"
  },
  "devDependencies": {
    "@namera-ai/ui": "workspace:*",
    "@react-email/ui": "6.11.0",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "klarity": "catalog:",
    "sharp": "0.35.5",
    "tsdown": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  }
}
