{
  "name": "@namera-ai/protocol",
  "version": "1.1.1",
  "description": "Runtime schemas, DTOs, models, and typed errors for the Namera API.",
  "keywords": [
    "effect",
    "ethereum",
    "namera",
    "schemas",
    "session-keys",
    "smart-account",
    "typescript",
    "wallet"
  ],
  "homepage": "https://namera.ai",
  "bugs": {
    "url": "https://github.com/thenamespace/namera/issues"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thenamespace/namera.git",
    "directory": "packages/protocol"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "imports": {
    "#/*": "./src/*.ts"
  },
  "exports": {
    ".": {
      "namera-source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./dto": {
      "namera-source": "./src/dto/index.ts",
      "default": "./dist/dto.js"
    },
    "./evm": {
      "namera-source": "./src/evm/index.ts",
      "default": "./dist/evm.js"
    },
    "./local": {
      "namera-source": "./src/local/index.ts",
      "default": "./dist/local.js"
    },
    "./model": {
      "namera-source": "./src/model/index.ts",
      "default": "./dist/model.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "imports": {
      "#/*": "./dist/*.js"
    },
    "exports": {
      ".": "./dist/index.js",
      "./dto": "./dist/dto.js",
      "./evm": "./dist/evm.js",
      "./local": "./dist/local.js",
      "./model": "./dist/model.js",
      "./package.json": "./package.json"
    },
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown --config tsdown.config.ts",
    "format": "oxfmt . --write --no-error-on-unmatched-pattern",
    "format:check": "oxfmt . --check --no-error-on-unmatched-pattern",
    "lint": "oxlint . --no-error-on-unmatched-pattern",
    "lint:fix": "oxlint . --fix --no-error-on-unmatched-pattern",
    "prepack": "pnpm run build",
    "test": "NODE_OPTIONS=--conditions=namera-source vitest run",
    "typecheck:test": "tsc -p tsconfig.test.json --pretty false",
    "typecheck": "tsc -p tsconfig.json --pretty false"
  },
  "dependencies": {
    "@adraffy/ens-normalize": "catalog:",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "klarity": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=24.14.0"
  }
}
