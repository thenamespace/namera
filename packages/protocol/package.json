{
  "name": "@namera-ai/protocol",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "files": [
    "dist"
  ],
  "type": "module",
  "imports": {
    "#/*": "./src/*.ts"
  },
  "exports": {
    ".": {
      "@namera-ai/source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./model": {
      "@namera-ai/source": "./src/model/index.ts",
      "default": "./dist/model.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.js",
      "./model": "./dist/model.js",
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "tsdown --config tsdown.config.ts",
    "format": "oxfmt . --write --no-error-on-unmatched-pattern",
    "format:check": "oxfmt . --check --no-error-on-unmatched-pattern",
    "lint": "oxlint . --no-error-on-unmatched-pattern",
    "lint:fix": "oxlint . --fix --no-error-on-unmatched-pattern",
    "prepack": "pnpm run build",
    "typecheck": "tsc -p tsconfig.json --pretty false"
  },
  "dependencies": {
    "effect": "catalog:"
  },
  "devDependencies": {
    "klarity": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  }
}
