{
  "name": "@namera-ai/ui",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "imports": {
    "#/*": "./src/*.ts",
    "#/components/*": "./src/components/*.tsx"
  },
  "exports": {
    ".": "./src/index.ts",
    "./icon-picker": "./src/components/icon-picker/index.tsx",
    "./chain-icon": "./src/icons/chain.tsx",
    "./icons": "./src/icons/index.ts",
    "./hooks": "./src/hooks.ts",
    "./utils": "./src/utils.ts",
    "./*": "./src/components/*.tsx",
    "./styles": {
      "style": "./src/styles/globals.css",
      "default": "./src/styles/globals.css"
    },
    "./styles.css": {
      "style": "./src/styles/globals.css",
      "default": "./src/styles/globals.css"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "format": "oxfmt . --write --no-error-on-unmatched-pattern",
    "format:check": "oxfmt . --check --no-error-on-unmatched-pattern",
    "lint": "oxlint . --no-error-on-unmatched-pattern",
    "lint:fix": "oxlint . --fix --no-error-on-unmatched-pattern",
    "typecheck": "tsc -p tsconfig.json --pretty false"
  },
  "dependencies": {
    "@namera-ai/protocol": "workspace:*",
    "@thenamespace/uikit": "0.3.0",
    "emojibase": "17.0.0",
    "emojibase-data": "17.0.0",
    "tailwindcss": "catalog:"
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "klarity": "catalog:",
    "react": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "react": "catalog:"
  }
}
