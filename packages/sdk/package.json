{
  "name": "@namera-ai/sdk",
  "version": "1.8.0",
  "description": "Scoped, revocable permissions for agent wallets on ERC-7579 smart accounts.",
  "keywords": [
    "account-abstraction",
    "agent-wallet",
    "effect",
    "erc-4337",
    "erc-7579",
    "permissions",
    "session-keys",
    "smart-sessions",
    "viem"
  ],
  "homepage": "https://github.com/thenamespace/namera/tree/main/packages/sdk#readme",
  "bugs": "https://github.com/thenamespace/namera/issues",
  "license": "Apache-2.0",
  "author": "Vedant Chainani (https://github.com/envoy1084)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thenamespace/namera.git",
    "directory": "packages/sdk"
  },
  "files": [
    "CHANGELOG.md",
    "dist",
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "workspace-source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.js",
      "./package.json": "./package.json"
    },
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "lint": "oxlint -c ../../.config/oxlint.config.ts --deny-warnings .",
    "pack:check": "publint && attw --pack . --profile esm-only",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "effect": "catalog:",
    "tsdown": "catalog:",
    "viem": "catalog:"
  },
  "peerDependencies": {
    "effect": "^4.1.5",
    "viem": "^2.57.0"
  },
  "engines": {
    "node": ">=22"
  }
}
