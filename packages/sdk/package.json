{
  "name": "@namera-ai/sdk",
  "version": "1.8.0",
  "description": "Scoped, revocable session keys for agents on ERC-7579 smart accounts, built on viem.",
  "keywords": [
    "account-abstraction",
    "agent-wallet",
    "erc-4337",
    "erc-7579",
    "permissions",
    "session-keys",
    "smart-accounts",
    "smart-sessions",
    "viem"
  ],
  "homepage": "https://github.com/thenamespace/namera/tree/main/packages/sdk#readme",
  "bugs": {
    "url": "https://github.com/thenamespace/namera/issues"
  },
  "license": "Apache-2.0",
  "author": "Vedant Chainani (https://github.com/envoy1084)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thenamespace/namera.git",
    "directory": "packages/sdk"
  },
  "files": [
    "src/**/*.ts",
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map",
    "CHANGELOG.md"
  ],
  "type": "module",
  "sideEffects": [],
  "exports": {
    "./package.json": "./package.json",
    ".": "./src/index.ts",
    "./accounts": "./src/accounts/index.ts",
    "./effect": "./src/effect/index.ts",
    "./effect/accounts": "./src/effect/accounts/index.ts",
    "./effect/keys": "./src/effect/keys/index.ts",
    "./keys": "./src/keys/index.ts",
    "./*": "./src/*.ts",
    "./accounts/internal/*": null,
    "./internal/*": null,
    "./keys/internal/*": null,
    "./testing/internal/*": null,
    "./index": null,
    "./*/index": null
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      "./package.json": "./package.json",
      ".": "./dist/index.js",
      "./accounts": "./dist/accounts/index.js",
      "./effect": "./dist/effect/index.js",
      "./effect/accounts": "./dist/effect/accounts/index.js",
      "./effect/keys": "./dist/effect/keys/index.js",
      "./keys": "./dist/keys/index.js",
      "./*": "./dist/*.js",
      "./accounts/internal/*": null,
      "./internal/*": null,
      "./keys/internal/*": null,
      "./testing/internal/*": null,
      "./index": null,
      "./*/index": null
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.json && babel dist --plugins annotate-pure-calls --out-dir dist --source-maps",
    "codegen": "cd ../.. && node scripts/bin.ts codegen --dir packages/sdk",
    "mutation": "stryker run"
  },
  "peerDependencies": {
    "effect": "^4.1.5",
    "viem": "^2.58.4"
  },
  "dependencies": {
    "@namera-ai/contracts": "workspace:^",
    "ox": "^1.8.19"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@namera-ai/devnet": "workspace:*",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "effect": "catalog:",
    "esbuild": "0.28.2",
    "miniflare": "4.20260730.0",
    "permissionless": "0.5.2",
    "tstyche": "7.2.5",
    "viem": "catalog:",
    "zod": "4.6.6"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
