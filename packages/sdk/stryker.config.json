{
  "$schema": "../../node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "plugins": [
    "@stryker-mutator/vitest-runner"
  ],
  "testRunner": "vitest",
  "vitest": {
    "configFile": "vitest.mutation.ts",
    "related": false
  },
  "mutate": [
    "src/internal/core/**/*.ts"
  ],
  "inPlace": true,
  "coverageAnalysis": "perTest",
  "thresholds": {
    "high": 100,
    "low": 100,
    "break": 100
  },
  "reporters": [
    "clear-text",
    "progress"
  ],
  "tempDirName": "../../node_modules/.cache/stryker-sdk"
}
