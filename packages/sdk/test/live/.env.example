# Live bundler and paymaster matrix (phase 017).
#
# Copy to `packages/sdk/test/live/.env` (git-ignored) and fill it in. The live suite runs only when NAMERA_LIVE=1, and
# reads this file; nothing here is ever committed, logged or sent anywhere but the vendor it belongs to.
#
# Chains: every vendor dashboard below must enable Base Sepolia (84532) and Sepolia (11155111). Base mainnet (8453)
# only if you choose the small mainnet run (NAMERA_LIVE_MAINNET=1).
#
# Leave a vendor's values empty to skip it: the suite reports it as "not configured" instead of failing.

# ----------------------------------------------------------------------------------------------------------------------
# Run options
# ----------------------------------------------------------------------------------------------------------------------

# Set to 1 to run the live suite (otherwise it is skipped).
NAMERA_LIVE=1
# Set to 1 to also run the small owner + agent check on Base mainnet (spends real ETH and USDC, a few dollars at most).
NAMERA_LIVE_MAINNET=0
# Set to 1 to include Etherspot in the full matrix (slow: ~95 s per operation). 0 runs it in a single smoke check only.
NAMERA_LIVE_ETHERSPOT_FULL=0

# ----------------------------------------------------------------------------------------------------------------------
# Test wallet: a dedicated, low-balance key, never the contract deployer
# ----------------------------------------------------------------------------------------------------------------------
#
# Create one: `cast wallet new`. Fund it on Base Sepolia (~0.1 ETH, ~20 USDC) and Sepolia (~0.05 ETH, ~10 USDC); test
# USDC from https://faucet.circle.com (10 USDC per request). It funds the test accounts the suite creates; most funds
# stay in those accounts.
#
# Either a raw private key (0x + 64 hex), or the name of a cast keystore (`cast wallet import namera-live
# --interactive`) with its password in NAMERA_LIVE_FUNDER_PASSWORD. Set one of the two.
NAMERA_LIVE_FUNDER_KEY=
NAMERA_LIVE_FUNDER_KEYSTORE=
NAMERA_LIVE_FUNDER_PASSWORD=

# ----------------------------------------------------------------------------------------------------------------------
# RPC endpoints (keyed endpoints recommended: public RPCs rate-limit the matrix)
# ----------------------------------------------------------------------------------------------------------------------

RPC_BASE_SEPOLIA=
RPC_SEPOLIA=
# Only for NAMERA_LIVE_MAINNET=1.
RPC_BASE=

# ----------------------------------------------------------------------------------------------------------------------
# Pimlico: bundler, sponsorship paymaster, ERC-20 (USDC) paymaster — https://dashboard.pimlico.io
# ----------------------------------------------------------------------------------------------------------------------
#
# 1. Create an API key with Base Sepolia and Sepolia enabled.
# 2. Create a sponsorship policy, set it ACTIVE, and enable it on both chains (an inactive policy fails with
#    `-32602 sponsorshipPolicy not active`).
# Pimlico's paymaster only accepts operations bundled by Pimlico or ZeroDev (`BundlerNotAllowed` elsewhere).
PIMLICO_API_KEY=
PIMLICO_SPONSORSHIP_POLICY_ID=

# ----------------------------------------------------------------------------------------------------------------------
# Alchemy: bundler and Gas Manager — https://dashboard.alchemy.com
# ----------------------------------------------------------------------------------------------------------------------
#
# 1. Create an app with Base Sepolia and Sepolia (and Base, for the mainnet run) enabled; copy its API key.
# 2. Create a Gas Manager policy of the on-chain paymaster type, enabled on the same chains.
ALCHEMY_API_KEY=
ALCHEMY_GAS_POLICY_ID=

# ----------------------------------------------------------------------------------------------------------------------
# Candide: bundler and sponsorship paymaster — https://dashboard.candide.dev
# ----------------------------------------------------------------------------------------------------------------------
#
# 1. Create an API key with Base Sepolia and Sepolia enabled.
# 2. Create a sponsorship policy per chain and ADD BILLING CREDIT (without it: `-32003 … insufficient_balance`).
CANDIDE_API_KEY=
CANDIDE_SPONSORSHIP_POLICY_ID_BASE_SEPOLIA=
CANDIDE_SPONSORSHIP_POLICY_ID_SEPOLIA=

# ----------------------------------------------------------------------------------------------------------------------
# ZeroDev: bundler, UltraRelay and sponsorship — https://dashboard.zerodev.app
# ----------------------------------------------------------------------------------------------------------------------
#
# Create a project with Base Sepolia and Sepolia, and a gas sponsorship policy for it. ZeroDev's paymaster is Pimlico's
# contract, so it too only works through the Pimlico and ZeroDev bundlers.
ZERODEV_PROJECT_ID=

# ----------------------------------------------------------------------------------------------------------------------
# Etherspot: Skandha bundler and Arka paymaster — https://developer.etherspot.io
# ----------------------------------------------------------------------------------------------------------------------
#
# 1. Create an API key covering Base Sepolia and Sepolia.
# 2. Create an Arka sponsorship policy and fund it (leave ARKA_POLICY_ID empty if the dashboard issues none). The policy
#    covers Base Sepolia only; on Sepolia the suite skips Arka.
# Etherspot's EntryPoint v0.7 endpoint refuses EIP-7702 authorizations; the suite expects that.
ETHERSPOT_API_KEY=
ARKA_POLICY_ID=

# ----------------------------------------------------------------------------------------------------------------------
# Circle Paymaster (USDC gas): nothing to configure
# ----------------------------------------------------------------------------------------------------------------------
#
# A public contract (no API key). The test accounts pay gas in USDC through an EIP-2612 permit, so the funder needs test
# USDC (see the test wallet above).
