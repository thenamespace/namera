{
  "name": "@namera-ai/api",
  "version": "1.0.1",
  "description": "Schema-derived Effect HttpApi contract for Namera.",
  "keywords": [
    "effect",
    "ethereum",
    "http-api",
    "namera",
    "session-keys",
    "smart-account",
    "typescript",
    "wallet"
  ],
  "homepage": "https://namera.ai",
  "bugs": {
    "url": "https://github.com/thenamespace/namera-core/issues"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thenamespace/namera-core.git",
    "directory": "packages/api"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "imports": {
    "#/*": "./src/*.ts"
  },
  "exports": {
    ".": {
      "namera-source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "imports": {
      "#/*": "./dist/*.js"
    },
    "exports": {
      ".": "./dist/index.js",
      "./package.json": "./package.json"
    },
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown --config tsdown.config.ts",
    "format": "oxfmt . --write --no-error-on-unmatched-pattern",
    "format:check": "oxfmt . --check --no-error-on-unmatched-pattern",
    "lint": "oxlint . --no-error-on-unmatched-pattern",
    "lint:fix": "oxlint . --fix --no-error-on-unmatched-pattern",
    "prepack": "pnpm run build",
    "typecheck": "tsc -p tsconfig.json --pretty false"
  },
  "dependencies": {
    "@namera-ai/protocol": "workspace:*",
    "effect": "catalog:"
  },
  "devDependencies": {
    "klarity": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=24.14.0"
  }
}
