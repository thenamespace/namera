{
  "name": "@namera-ai/telemetry",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "files": [
    "dist"
  ],
  "type": "module",
  "imports": {
    "#/*": "./src/*.ts"
  },
  "exports": {
    ".": {
      "namera-source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./analytics/browser": {
      "namera-source": "./src/analytics/browser.ts",
      "default": "./dist/analytics/browser.js"
    },
    "./analytics/collection": {
      "namera-source": "./src/analytics/collection.ts",
      "default": "./dist/analytics/collection.js"
    },
    "./analytics/contract": {
      "namera-source": "./src/analytics/contract.ts",
      "default": "./dist/analytics/contract.js"
    },
    "./analytics/server": {
      "namera-source": "./src/analytics/server.ts",
      "default": "./dist/analytics/server.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "imports": {
      "#/*": "./dist/*.js"
    },
    "exports": {
      ".": "./dist/index.js",
      "./analytics/browser": "./dist/analytics/browser.js",
      "./analytics/collection": "./dist/analytics/collection.js",
      "./analytics/contract": "./dist/analytics/contract.js",
      "./analytics/server": "./dist/analytics/server.js",
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "tsdown --config tsdown.config.ts",
    "format": "oxfmt . --write --no-error-on-unmatched-pattern",
    "format:check": "oxfmt . --check --no-error-on-unmatched-pattern",
    "lint": "oxlint . --no-error-on-unmatched-pattern",
    "lint:fix": "oxlint . --fix --no-error-on-unmatched-pattern",
    "prepack": "pnpm run build",
    "test": "vitest run",
    "typecheck:test": "tsc -p tsconfig.test.json --pretty false",
    "typecheck": "tsc -p tsconfig.json --pretty false"
  },
  "dependencies": {
    "effect": "catalog:",
    "posthog-js": "^1.438.7",
    "posthog-node": "^5.55.1"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "klarity": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
