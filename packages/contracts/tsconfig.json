{
  "extends": "klarity/tsconfig/library",
  "compilerOptions": {
    "customConditions": ["workspace-source"],
    "rootDir": ".",
    "erasableSyntaxOnly": true,
    "noErrorTruncation": true,
    "plugins": [
      {
        "name": "@effect/language-service",
        "diagnosticSeverity": {
          "experimentalApiUsage": "off",
          "unstableApiUsage": "off"
        },
        "keyPatterns": [
          {
            "target": "service",
            "pattern": "package-identifier"
          }
        ],
        "allowedUnstableApis": ["@effect/platform-node", "@effect/vitest", "effect/FileSystem"],
        "allowedExperimentalApis": ["@namera-ai/contracts"]
      }
    ]
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "scripts/**/*.ts"]
}
