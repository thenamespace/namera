{
  "$schema": "../../node_modules/@effect/docgen/schema.json",
  "exclude": ["src/internal/**/*.ts"],
  "parseCompilerOptions": {
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "moduleResolution": "Bundler",
    "module": "ESNext",
    "target": "ES2022",
    "lib": ["ES2022"],
    "allowImportingTsExtensions": true,
    "paths": {
      "@namera-ai/contracts": ["./src/index.ts"],
      "@namera-ai/contracts/*": ["./src/*.ts"]
    }
  },
  "examplesCompilerOptions": {
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "moduleResolution": "Bundler",
    "module": "ESNext",
    "target": "ES2022",
    "lib": ["ES2022"],
    "allowImportingTsExtensions": true,
    "paths": {
      "@namera-ai/contracts": ["../../src/index.ts"],
      "@namera-ai/contracts/*": ["../../src/*.ts"]
    }
  }
}
