{
  "name": "@namera-ai/schema",
  "version": "0.0.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./database": "./src/database/index.ts",
    "./dto": "./src/dto/index.ts"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "import": "./dist/index.mjs",
        "types": "./dist/index.d.mts"
      },
      "./database": {
        "import": "./dist/database.mjs",
        "types": "./dist/database.d.mts"
      },
      "./dto": {
        "import": "./dist/dto.mjs",
        "types": "./dist/dto.d.mts"
      }
    },
    "provenance": true
  },
  "scripts": {
    "build": "tsdown"
  },
  "dependencies": {
    "drizzle-orm": "catalog:",
    "effect": "catalog:",
    "viem": "catalog:"
  },
  "devDependencies": {
    "@namera-ai/config": "workspace:*",
    "@types/node": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  }
}
