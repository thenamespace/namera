{
  "name": "@namera-ai/database",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "files": [
    "dist",
    "migrations"
  ],
  "type": "module",
  "imports": {
    "#/*": "./src/*.ts"
  },
  "exports": {
    ".": {
      "namera-source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "imports": {
      "#/*": "./dist/*.js"
    },
    "exports": {
      ".": "./dist/index.js",
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "tsdown --config tsdown.config.ts",
    "format": "oxfmt . --write --no-error-on-unmatched-pattern",
    "format:check": "oxfmt . --check --no-error-on-unmatched-pattern",
    "lint": "oxlint . --no-error-on-unmatched-pattern",
    "lint:fix": "oxlint . --fix --no-error-on-unmatched-pattern",
    "prepack": "pnpm run build",
    "test": "NODE_OPTIONS=--conditions=namera-source vitest run",
    "test:watch": "NODE_OPTIONS=--conditions=namera-source vitest",
    "typecheck": "tsc -p tsconfig.json --pretty false",
    "typecheck:test": "tsc -p tsconfig.test.json --pretty false",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env --conditions=namera-source src/migrations/run.ts",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@effect/sql-pg": "catalog:",
    "@effect/sql-pglite": "catalog:",
    "@electric-sql/pglite": "catalog:",
    "@namera-ai/protocol": "workspace:*",
    "@namera-ai/utils": "workspace:*",
    "drizzle-orm": "catalog:",
    "effect": "catalog:",
    "pg": "8.22.0"
  },
  "devDependencies": {
    "@effect/platform-node": "catalog:",
    "@effect/vitest": "catalog:",
    "@types/node": "catalog:",
    "@types/pg": "8.20.4",
    "drizzle-kit": "catalog:",
    "klarity": "catalog:",
    "tsdown": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
