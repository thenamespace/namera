{
  "name": "@namera-ai/database",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "files": [
    "dist"
  ],
  "type": "module",
  "imports": {
    "#/*": "./src/*.ts"
  },
  "exports": {
    ".": {
      "@namera-ai/source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.js",
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "tsdown --config tsdown.config.ts",
    "format": "oxfmt . --write --no-error-on-unmatched-pattern",
    "format:check": "oxfmt . --check --no-error-on-unmatched-pattern",
    "lint": "oxlint . --no-error-on-unmatched-pattern",
    "lint:fix": "oxlint . --fix --no-error-on-unmatched-pattern",
    "prepack": "pnpm run build",
    "typecheck": "tsc -p tsconfig.json --pretty false",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@effect/sql-pg": "catalog:",
    "@namera-ai/protocol": "workspace:*",
    "drizzle-orm": "catalog:",
    "effect": "catalog:",
    "pg": "8.22.0",
    "uuid": "14.0.1"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/pg": "8.20.4",
    "drizzle-kit": "catalog:",
    "klarity": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  }
}
