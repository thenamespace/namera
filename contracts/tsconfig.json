{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../tsconfig.base.json",
  "include": [
    "script/**/*.ts"
  ],
  "compilerOptions": {
    "rootDir": ".",
    "composite": false,
    "incremental": false,
    "noEmit": true,
    "types": [
      "node"
    ],
    "declarationMap": false,
    "sourceMap": false
  }
}
