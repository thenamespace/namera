# Copy to .env (git-ignored). Read by the deploy runner (pnpm chains:*), forge scripts and fork tests.

# `cast wallet import <name> --interactive` creates the keystore; never put a raw private key here.
DEPLOYER_ACCOUNT=namera-deployer

# Etherscan V2: one key for every Etherscan-supported chain. Sourcify needs no key.
ETHERSCAN_API_KEY=

# RPC endpoints. Defaults are the public RPCs from chains/chains.json; replace with keyed endpoints
# (Alchemy, QuickNode, ...) for reliability. An unset variable falls back to the public RPC.

# Mainnets
RPC_ETHEREUM=https://ethereum.reth.rs/rpc
RPC_BASE=https://mainnet.base.org
RPC_ARBITRUM=https://arb1.arbitrum.io/rpc
RPC_OPTIMISM=https://mainnet.optimism.io
RPC_POLYGON=https://polygon.drpc.org
RPC_BNB=https://56.rpc.thirdweb.com
RPC_AVALANCHE=https://api.avax.network/ext/bc/C/rpc
RPC_UNICHAIN=https://mainnet.unichain.org/
RPC_WORLD_CHAIN=https://worldchain-mainnet.g.alchemy.com/public
RPC_GNOSIS=https://rpc.gnosischain.com
RPC_SONIC=https://rpc.soniclabs.com
RPC_MONAD=https://rpc.monad.xyz
RPC_HYPEREVM=https://rpc.hyperliquid.xyz/evm
RPC_PLASMA=https://rpc.plasma.to
RPC_ROBINHOOD=https://rpc.mainnet.chain.robinhood.com
RPC_ARC=https://rpc.mainnet.arc.io
RPC_TEMPO=https://rpc.tempo.xyz
RPC_MEGAETH=https://mainnet.megaeth.com/rpc
RPC_INK=https://rpc-gel.inkonchain.com
RPC_LINEA=https://rpc.linea.build

