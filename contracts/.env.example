# Copy to .env (git-ignored). Loaded by the deploy runner (pnpm status|deploy|verify) and by forge.

# `cast wallet import <name> --interactive` creates the keystore; never put a raw private key here.
DEPLOYER_ACCOUNT=namera-deployer

# Etherscan V2: one key for every Etherscan-supported chain. Sourcify needs no key.
ETHERSCAN_API_KEY=

# Optional per-chain RPC overrides; otherwise each chain's publicRpc from chains/chains.json is used.
# Names come from `rpcEnv` in chains/chains.json, e.g.:
# RPC_BASE=
# RPC_BASE_SEPOLIA=
