{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.base.json",
  "references": [
    {
      "path": "tsconfig.packages.json"
    }
  ],
  "include": [
    "**/vitest.*.ts",
    "./vitest.setup.ts",
    "./packages/*/test/**/*.ts",
    "./packages/*/typetest/**/*.ts",
    "./packages/*/benchmark/**/*.ts",
    "./tools/*/test/**/*.ts"
  ],
  "exclude": [
    "**/node_modules/**",
    "**/dist/**"
  ],
  "compilerOptions": {
    "rootDir": ".",
    "noEmit": true,
    "erasableSyntaxOnly": false,
    "resolveJsonModule": true,
    "types": [
      "node"
    ],
    "tsBuildInfoFile": "${configDir}/node_modules/.cache/tsconfig.tests.tsbuildinfo"
  }
}
