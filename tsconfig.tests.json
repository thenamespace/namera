{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.base.json",
  "references": [
    {
      "path": "tsconfig.packages.json"
    }
  ],
  "include": [
    "**/vitest.*.ts",
    "./vitest.setup.ts",
    "./packages/*/test/**/*.ts",
    "./packages/*/typetest/**/*.ts",
    "./packages/*/benchmark/**/*.ts",
    "./tools/*/test/**/*.ts",
    "./packages/*/bundle/**/*.ts",
    "./scripts/**/*.ts"
  ],
  "exclude": [
    "**/node_modules/**",
    "**/dist/**",
    "./tools/oxc/test/fixtures/**"
  ],
  "compilerOptions": {
    "rootDir": ".",
    "noEmit": true,
    "erasableSyntaxOnly": false,
    "resolveJsonModule": true,
    "types": [
      "node"
    ],
    "tsBuildInfoFile": "${configDir}/node_modules/.cache/tsconfig.tests.tsbuildinfo",
    "paths": {
      "@namera-ai/sdk": [
        "./packages/sdk/src/index.ts"
      ],
      "@namera-ai/sdk/effect": [
        "./packages/sdk/src/effect/index.ts"
      ],
      "@namera-ai/sdk/*": [
        "./packages/sdk/src/*.ts"
      ]
    }
  }
}
