{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.base.json",
  "references": [
    {
      "path": "tsconfig.packages.json"
    }
  ],
  "include": [
    "./vitest.*.ts",
    "./scripts/**/*.ts",
    "./packages/*/test/**/*.ts",
    "./packages/*/test/**/*.tsx",
    "./packages/*/typetest/**/*.ts",
    "./packages/*/benchmark/**/*.ts",
    "./packages/*/bundle/**/*.ts",
    "./contracts/script/**/*.ts"
  ],
  "exclude": [
    "**/node_modules/**",
    "**/dist/**",
    "./scripts/test/oxlint/fixtures/**"
  ],
  "compilerOptions": {
    "rootDir": ".",
    "noEmit": true,
    "erasableSyntaxOnly": false,
    "resolveJsonModule": true,
    "types": [
      "node"
    ],
    "paths": {
      "@namera-ai/contracts": [
        "./packages/contracts/src/index.ts"
      ],
      "@namera-ai/contracts/*": [
        "./packages/contracts/src/*.ts"
      ],
      "@namera-ai/sdk": [
        "./packages/sdk/src/index.ts"
      ],
      "@namera-ai/sdk/effect": [
        "./packages/sdk/src/effect/index.ts"
      ],
      "@namera-ai/sdk/*": [
        "./packages/sdk/src/*.ts"
      ]
    },
    "plugins": [
      {
        "name": "@effect/language-service",
        "effectFn": [
          "untraced"
        ],
        "namespaceImportPackages": [],
        "includeSuggestionsInTsc": false,
        "ignoreEffectWarningsInTscExitCode": true,
        "ignoreEffectErrorsInTscExitCode": false,
        "overrides": [
          {
            "include": [
              "**/typetest/**/*.ts"
            ],
            "options": {
              "diagnosticSeverity": {
                "floatingEffect": "off"
              }
            }
          }
        ],
        "diagnosticSeverity": {
          "unknownInEffectCatch": "off",
          "multipleEffectProvide": "off",
          "unstableApiUsage": "off",
          "effectFnOpportunity": "error"
        }
      }
    ]
  }
}
