{
  "$schema": "https://unpkg.com/@changesets/config@4.0.0-next.8/schema.json",
  "changelog": ["@changesets/changelog-github", { "repo": "thenamespace/namera" }],
  "commit": false,
  "format": false,
  "linked": [],
  "fixed": [["@namera-ai/sdk", "@namera-ai/contracts"]],
  "access": "restricted",
  "baseBranch": "main",
  "updateInternalDependencies": "patch",
  "ignore": ["scratchpad", "scripts"],
  "privatePackages": false,
  "snapshot": {
    "useCalculatedVersion": false,
    "prereleaseTemplate": "{tag}-{commit}"
  }
}
