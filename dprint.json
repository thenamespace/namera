{
  "$schema": "https://dprint.dev/schemas/v0.json",
  "incremental": false,
  "includes": [
    "**/*.{ts,tsx,js,jsx,mjs,json,md}"
  ],
  "indentWidth": 2,
  "lineWidth": 120,
  "newLineKind": "lf",
  "typescript": {
    "semiColons": "asi",
    "quoteStyle": "alwaysDouble",
    "trailingCommas": "never",
    "operatorPosition": "maintain",
    "arrowFunction.useParentheses": "force"
  },
  "excludes": [
    "**/dist",
    "**/build",
    "**/coverage",
    "**/*.tsbuildinfo",
    "**/CHANGELOG.md",
    "**/.data",
    "pnpm-lock.yaml",
    "LLMS.md",
    "tmp/**",
    "research/**",
    "**/.next",
    "**/.output",
    "**/routeTree.gen.ts",
    "packages/*/etc",
    "contracts/broadcast",
    "contracts/cache",
    "contracts/dependencies",
    "contracts/lib",
    "contracts/out"
  ],
  "plugins": [
    "https://plugins.dprint.dev/typescript-0.93.4.wasm",
    "https://plugins.dprint.dev/markdown-0.20.0.wasm",
    "https://plugins.dprint.dev/json-0.21.1.wasm"
  ]
}
