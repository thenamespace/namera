{
  "name": "namera",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "check": "oxfmt -c .config/oxfmt.config.ts --check . && oxlint -c .config/oxlint.config.ts --deny-warnings . && turbo run typecheck test build",
    "dev": "turbo run dev",
    "format": "oxfmt -c .config/oxfmt.config.ts --write .",
    "format:check": "oxfmt -c .config/oxfmt.config.ts --check .",
    "lint": "oxlint -c .config/oxlint.config.ts --deny-warnings .",
    "lint:fix": "oxlint -c .config/oxlint.config.ts --fix .",
    "prepare": "lefthook install",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "@types/node": "catalog:",
    "klarity": "catalog:",
    "lefthook": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=24.14.0"
  },
  "packageManager": "pnpm@12.21.0"
}
