{
  "name": "namera",
  "version": "0.0.0",
  "private": true,
  "description": "Scoped, revocable permissions for agent wallets on ERC-7579 smart accounts.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "api-snapshot": "node scripts/api-snapshot.ts",
    "build": "turbo --root-turbo-json .config/turbo.json run build",
    "bundle-size": "node scripts/bundle-size.ts",
    "changeset": "changeset",
    "check": "pnpm format:check && pnpm lint && pnpm circular && turbo --root-turbo-json .config/turbo.json run typecheck build && pnpm check-dist-types && pnpm api-snapshot --check && pnpm bundle-size && pnpm type-cost && pnpm docgen && pnpm test && pnpm doctest && pnpm test-types && pnpm test:contracts && namera-dev contracts generate --check && namera-dev codegen --check --dir packages/sdk && namera-dev codegen --check --dir packages/devnet && namera-dev devnet bytecode --check",
    "check-dist-types": "node scripts/check-dist-types.ts",
    "circular": "node scripts/circular.ts",
    "contracts:deploy": "namera-dev contracts deploy",
    "contracts:generate": "namera-dev contracts generate",
    "contracts:record": "namera-dev contracts record",
    "contracts:status": "namera-dev contracts status",
    "contracts:verify": "namera-dev contracts verify",
    "coverage": "vitest run --coverage",
    "dev": "turbo --root-turbo-json .config/turbo.json run dev",
    "docgen": "turbo --root-turbo-json .config/turbo.json run docgen",
    "doctest": "vitest run --config vitest.docs.ts",
    "format": "dprint fmt",
    "format:check": "dprint check",
    "lint": "oxlint --deny-warnings && turbo --root-turbo-json .config/turbo.json run lint",
    "lint:fix": "oxlint --fix",
    "pack:check": "turbo --root-turbo-json .config/turbo.json run pack:check",
    "prepare": "lefthook install && effect-tsgo patch",
    "release:build": "node scripts/set-strip-internal.ts && turbo --root-turbo-json .config/turbo.json run build --force && pnpm check-dist-types",
    "release:check": "namera-dev release check",
    "release:smoke": "namera-dev release smoke",
    "release:version": "changeset version && namera-dev codegen --dir packages/sdk && pnpm install --lockfile-only && pnpm format",
    "test": "vitest run",
    "test-types": "tstyche",
    "test:contracts": "pnpm --filter @namera-ai/contracts-sol test",
    "test:watch": "vitest",
    "type-cost": "node scripts/type-cost.ts",
    "typecheck": "tsc -b tsconfig.json"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@babel/cli": "8.1.0",
    "@babel/core": "8.1.3",
    "@changesets/changelog-github": "1.0.1",
    "@changesets/cli": "3.0.3",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@effect/docgen": "4.1.5",
    "@effect/doctest": "4.1.5",
    "@effect/tsgo": "catalog:",
    "@effect/vitest": "catalog:",
    "@interfere/landmines": "catalog:",
    "@namera-ai/oxc": "workspace:*",
    "@namera-ai/tools": "workspace:*",
    "@rollup/plugin-node-resolve": "16.0.3",
    "@types/madge": "5.0.3",
    "@types/node": "catalog:",
    "@vitest/browser-playwright": "5.1.1",
    "@vitest/coverage-v8": "5.1.1",
    "babel-plugin-annotate-pure-calls": "0.5.0",
    "dprint": "0.65.0",
    "effect": "catalog:",
    "esbuild": "0.28.2",
    "glob": "14.0.6",
    "klarity": "catalog:",
    "lefthook": "2.2.2",
    "madge": "8.0.0",
    "oxlint": "catalog:",
    "playwright": "1.65.1",
    "publint": "0.3.25",
    "rollup": "4.68.8",
    "rollup-plugin-esbuild": "6.2.1",
    "tstyche": "7.2.5",
    "tsx": "4.23.15",
    "turbo": "2.11.13",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@12.21.0"
}
