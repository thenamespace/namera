{
  "name": "namera",
  "version": "0.0.0",
  "private": true,
  "description": "Scoped, revocable permissions for agent wallets on ERC-7579 smart accounts.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "turbo --root-turbo-json .config/turbo.json run build",
    "changeset": "changeset",
    "check": "pnpm format:check && pnpm lint && turbo --root-turbo-json .config/turbo.json run typecheck build && pnpm test && pnpm doctest && pnpm test-types && pnpm test:contracts && namera-dev contracts generate --check",
    "contracts:deploy": "namera-dev contracts deploy",
    "contracts:generate": "namera-dev contracts generate",
    "contracts:record": "namera-dev contracts record",
    "contracts:status": "namera-dev contracts status",
    "contracts:verify": "namera-dev contracts verify",
    "coverage": "vitest run --coverage",
    "dev": "turbo --root-turbo-json .config/turbo.json run dev",
    "doctest": "vitest run --config vitest.docs.ts",
    "format": "dprint fmt",
    "format:check": "dprint check",
    "lint": "oxlint --deny-warnings && turbo --root-turbo-json .config/turbo.json run lint",
    "lint:fix": "oxlint --fix",
    "pack:check": "turbo --root-turbo-json .config/turbo.json run pack:check",
    "prepare": "lefthook install && effect-tsgo patch",
    "release:check": "namera-dev release check",
    "release:smoke": "namera-dev release smoke",
    "release:version": "changeset version && pnpm install --lockfile-only && pnpm format",
    "test": "vitest run",
    "test-types": "tstyche",
    "test:contracts": "pnpm --filter @namera-ai/contracts-sol test",
    "test:watch": "vitest",
    "typecheck": "tsc -b tsconfig.json"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@babel/cli": "8.1.0",
    "@babel/core": "8.1.3",
    "@changesets/cli": "3.0.3",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@effect/doctest": "4.1.5",
    "@effect/tsgo": "catalog:",
    "@effect/vitest": "catalog:",
    "@interfere/landmines": "catalog:",
    "@namera-ai/oxc": "workspace:*",
    "@namera-ai/tools": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "5.1.1",
    "babel-plugin-annotate-pure-calls": "0.5.0",
    "dprint": "0.65.0",
    "effect": "catalog:",
    "klarity": "catalog:",
    "lefthook": "2.2.2",
    "oxlint": "catalog:",
    "publint": "0.3.25",
    "tstyche": "7.2.5",
    "turbo": "2.11.13",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@12.21.0"
}
