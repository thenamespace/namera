{
  "name": "namera",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "check": "oxfmt --check . && turbo run lint typecheck build",
    "dev": "turbo run dev",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "turbo run lint",
    "lint:fix": "oxlint --fix .",
    "prepare": "lefthook install",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "catalog:",
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "@effect/language-service": "catalog:",
    "effect": "catalog:",
    "klarity": "catalog:",
    "lefthook": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "publint": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=24.14.0"
  },
  "packageManager": "pnpm@11.18.0"
}
